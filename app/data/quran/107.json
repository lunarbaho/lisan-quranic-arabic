{"s":107,"v":[{"a":1,"w":[["أَرَءَيْتَ","Have you seen","gördün mü?",1,[["أَ",82,4799],["رَءَيْ",244,45],["تَ",18,73]]],["ٱلَّذِى","the one who","kimseyi",0,[["ٱلَّذِى",92,6]]],["يُكَذِّبُ","denies","yalanlayan",0,[["يُكَذِّبُ",310,66]]],["بِٱلدِّينِ","the Judgment","dini",2,[["بِ",0,4798],["ٱل",3,4795],["دِّينِ",1,118]]]],"en":"Have you seen the one who denies the Recompense?","tr":"Dini yalan sayanı gördün mü?","de":"Siehst du (nicht) denjenigen, der das Gericht für Lüge erklärt?"},{"a":2,"w":[["فَذَٰلِكَ","Then that","işte o",1,[["فَ",10,4797],["ذَٰ",25,21],["لِ",26,4796],["كَ",27,-1]]],["ٱلَّذِى","(is) the one who","iter kakar",0,[["ٱلَّذِى",92,6]]],["يَدُعُّ","repulses","",0,[["يَدُعُّ",54,2780]]],["ٱلْيَتِيمَ","the orphan","öksüzü",1,[["ٱلْ",3,4795],["يَتِيمَ",189,451]]]],"en":"For that is the one who drives away the orphan","tr":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur.","de":"Das ist derjenige, der die Waise zurückstößt"},{"a":3,"w":[["وَلَا","And (does) not","ve",1,[["وَ",10,4794],["لَا",22,3]]],["يَحُضُّ","feel the urge","teşvik etmez",0,[["يَحُضُّ",54,2773]]],["عَلَىٰ","to","doyurmaya",0,[["عَلَىٰ",19,7]]],["طَعَامِ","feed","",0,[["طَعَامِ",1,436]]],["ٱلْمِسْكِينِ","the poor","yoksulu",1,[["ٱلْ",3,4795],["مِسْكِينِ",263,450]]]],"en":"And does not encourage the feeding of the poor.","tr":"Öksüzü kakıştıran, yoksulu doyurmaya yanaşmayan kimse işte odur.","de":"und nicht zur Speisung des Armen anhält."},{"a":4,"w":[["فَوَيْلٌۭ","So woe","vay haline",1,[["فَ",34,4797],["وَيْلٌ",30,285]]],["لِّلْمُصَلِّينَ","to those who pray","namaz kılanların",2,[["لِّ",0,4796],["لْ",3,4795],["مُصَلِّينَ",533,1923]]]],"en":"So woe to those who pray","tr":"Vay o namaz kılanların haline ki:","de":"Wehe nun den Betenden,"},{"a":5,"w":[["ٱلَّذِينَ","Those who","ki",0,[["ٱلَّذِينَ",16,6]]],["هُمْ","[they]","onlar",0,[["هُمْ",40,12]]],["عَن","about","namazlarından",0,[["عَن",19,23]]],["صَلَاتِهِمْ","their prayers","",0,[["صَلَاتِ",72,133],["هِمْ",20,12]]],["سَاهُونَ","(are) neglectful","gaflet ederler",0,[["سَاهُونَ",136,2311]]]],"en":"[But] who are heedless of their prayer -","tr":"Onlar kıldıkları namazdan gafildirler.","de":"denjenigen, die auf ihre Gebete nicht achten,"},{"a":6,"w":[["ٱلَّذِينَ","Those who","ki",0,[["ٱلَّذِينَ",16,6]]],["هُمْ","[they]","onlar",0,[["هُمْ",40,12]]],["يُرَآءُونَ","make show","gösteriş yaparlar",0,[["يُرَآءُ",59,2815],["ونَ",20,12]]]],"en":"Those who make show [of their deeds]","tr":"Onlar gösteriş yaparlar.","de":"denjenigen, die dabei (nur) gesehen werden wollen;"},{"a":7,"w":[["وَيَمْنَعُونَ","And they deny","ve esirgerler",1,[["وَ",10,4794],["يَمْنَعُ",62,746],["ونَ",20,12]]],["ٱلْمَاعُونَ","[the] small kindnesses","en ufak bir yardımı",1,[["ٱلْ",3,4795],["مَاعُونَ",14,3754]]]],"en":"And withhold [simple] assistance.","tr":"Onlar basit şeyleri dahi vermezler.","de":"und die Hilfeleistung verweigern!"}]}