{"s":101,"v":[{"a":1,"w":[["ٱلْقَارِعَةُ","The Striking Calamity","çarpan olay",1,[["ٱلْ",3,4795],["قَارِعَةُ",90,1328]]]],"en":"The Striking Calamity -","tr":"Gürültü koparacak olan","de":"Das Verhängnis!"},{"a":2,"w":[["مَا","What","nedir?",0,[["مَا",140,8]]],["ٱلْقَارِعَةُ","(is) the Striking Calamity","çarpan olay",1,[["ٱلْ",3,4795],["قَارِعَةُ",90,1328]]]],"en":"What is the Striking Calamity?","tr":"Nedir o gürültü koparacak olan?","de":"Was ist das Verhängnis?"},{"a":3,"w":[["وَمَآ","And what","nedir",1,[["وَ",10,4794],["مَآ",140,8]]],["أَدْرَىٰكَ","will make you know","sana bildiren",0,[["أَدْرَىٰ",80,569],["كَ",18,73]]],["مَا","what","ne olduğunu",0,[["مَا",140,8]]],["ٱلْقَارِعَةُ","(is) the Striking Calamity","çarpan olayın",1,[["ٱلْ",3,4795],["قَارِعَةُ",90,1328]]]],"en":"And what can make you know what is the Striking Calamity?","tr":"O gürültü koparacak olanın ne olduğunu sen bilir misin?","de":"Und was läßt dich wissen, was das Verhängnis ist?"},{"a":4,"w":[["يَوْمَ","(The) Day","o gün",0,[["يَوْمَ",271,22]]],["يَكُونُ","will be","olur(lar)",0,[["يَكُونُ",441,9]]],["ٱلنَّاسُ","the mankind","insanlar",1,[["ٱل",3,4795],["نَّاسُ",81,51]]],["كَٱلْفَرَاشِ","like moths","pervaneler gibi",2,[["كَ",0,4802],["ٱلْ",3,4795],["فَرَاشِ",1,3617]]],["ٱلْمَبْثُوثِ","scattered","yayılmış",1,[["ٱلْ",3,4795],["مَبْثُوثِ",1015,3762]]]],"en":"It is the Day when people will be like moths, dispersed,","tr":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler.","de":"Am Tag, da die Menschen wie flatternde Motten sein werden"},{"a":5,"w":[["وَتَكُونُ","And will be","ve olurlar",1,[["وَ",10,4794],["تَكُونُ",672,9]]],["ٱلْجِبَالُ","the mountains","dağlar",1,[["ٱلْ",3,4795],["جِبَالُ",81,298]]],["كَٱلْعِهْنِ","like wool","renkli yün gibi",2,[["كَ",0,4802],["ٱلْ",3,4795],["عِهْنِ",1,2414]]],["ٱلْمَنفُوشِ","fluffed up","atılmış",1,[["ٱلْ",3,4795],["مَنفُوشِ",1015,3878]]]],"en":"And the mountains will be like wool, fluffed up.","tr":"Dağlar, atılmış renkli yüne benzeyecekler.","de":"und die Berge wie zerflockte gefärbte Wolle sein werden."},{"a":6,"w":[["فَأَمَّا","Then as for","ama",1,[["فَ",34,4797],["أَمَّا",139,212]]],["مَن","(him) whose","kimin",0,[["مَن",182,13]]],["ثَقُلَتْ","(are) heavy","ağır gelirse",0,[["ثَقُلَتْ",89,1638]]],["مَوَٰزِينُهُۥ","his scales","tartıları",0,[["مَوَٰزِينُ",81,589],["هُۥ",29,10]]]],"en":"Then as for one whose scales are heavy [with good deeds],","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","de":"Was nun jemanden angeht, dessen Waagschalen schwer sind,"},{"a":7,"w":[["فَهُوَ","Then he","o",1,[["فَ",119,4797],["هُوَ",113,10]]],["فِى","(will be) in","içindedir",0,[["فِى",19,2]]],["عِيشَةٍۢ","a life","bir hayat",0,[["عِيشَةٍ",120,2415]]],["رَّاضِيَةٍۢ","pleasant","memmun edici",0,[["رَّاضِيَةٍ",703,1491]]]],"en":"He will be in a pleasant life.","tr":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","de":"so wird er in einem zufriedenen Leben sein."},{"a":8,"w":[["وَأَمَّا","But as for","ve fakat",1,[["وَ",10,4794],["أَمَّا",139,212]]],["مَنْ","(him) whose","kimin",0,[["مَنْ",182,13]]],["خَفَّتْ","(are) light","hafif gelirse",0,[["خَفَّتْ",89,2020]]],["مَوَٰزِينُهُۥ","his scales","tartıları",0,[["مَوَٰزِينُ",81,589],["هُۥ",29,10]]]],"en":"But as for one whose scales are light,","tr":"Tartıları hafif gelenler ise,","de":"Was aber jemanden angeht, dessen Waagschalen leicht sind,"},{"a":9,"w":[["فَأُمُّهُۥ","His abode","onun anası",1,[["فَ",119,4797],["أُمُّ",208,334],["هُۥ",29,10]]],["هَاوِيَةٌۭ","(will be the) Pit","haviye(uçurum)dur",0,[["هَاوِيَةٌ",424,4193]]]],"en":"His refuge will be an abyss.","tr":"Onların yeri bir çukurdur.","de":"dessen Mutter wird ein Abgrund sein."},{"a":10,"w":[["وَمَآ","And what","nedir?",1,[["وَ",10,4794],["مَآ",140,8]]],["أَدْرَىٰكَ","will make you know","sana bildiren",0,[["أَدْرَىٰ",80,569],["كَ",18,73]]],["مَا","what","ne olduğunu",0,[["مَا",140,8]]],["هِيَهْ","it is","onun",0,[["هِيَهْ",235,61]]]],"en":"And what can make you know what that is?","tr":"O çukurun ne olduğunu sen bilir misin?","de":"Und was läßt dich wissen, was das ist?"},{"a":11,"w":[["نَارٌ","A Fire","bir ateştir",0,[["نَارٌ",52,83]]],["حَامِيَةٌۢ","intensely hot","kızgın",0,[["حَامِيَةٌۢ",377,2225]]]],"en":"It is a Fire, intensely hot.","tr":"O, kızgın bir ateştir.","de":"Ein sehr heißes Feuer."}]}