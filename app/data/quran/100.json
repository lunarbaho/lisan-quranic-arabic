{"s":100,"v":[{"a":1,"w":[["وَٱلْعَـٰدِيَـٰتِ","By the racers","andolsun koşanlara (atlara)",2,[["وَ",0,4794],["ٱلْ",3,4795],["عَٰدِيَٰتِ",619,3517]]],["ضَبْحًۭا","panting","soluk soluğa",0,[["ضَبْحًا",65,3479]]]],"en":"By the racers, panting,","tr":"And olsun Allah yolunda koştukça koşanlara;","de":"Bei den schnaubend Rennenden,"},{"a":2,"w":[["فَٱلْمُورِيَـٰتِ","And the producers of sparks","(tırnaklarıyla) ateş çıkaranlara",2,[["فَ",10,4797],["ٱلْ",3,4795],["مُورِيَٰتِ",638,4105]]],["قَدْحًۭا","striking","çarparak",0,[["قَدْحًا",65,3665]]]],"en":"And the producers of sparks [when] striking","tr":"And olsun kıvılcımlar saçanlara;","de":"den (mit ihren Hufen) Funken Schlagenden,"},{"a":3,"w":[["فَٱلْمُغِيرَٰتِ","And the chargers","akın edenlere",2,[["فَ",10,4797],["ٱلْ",3,4795],["مُغِيرَٰتِ",638,4041]]],["صُبْحًۭا","(at) dawn","sabahleyin",0,[["صُبْحًا",288,1307]]]],"en":"And the chargers at dawn,","tr":"Sabah sabah akına çıkanlara;","de":"den am Morgen Angreifenden,"},{"a":4,"w":[["فَأَثَرْنَ","Then raise","toz koparanlara",1,[["فَ",10,4797],["أَثَرْ",569,1373],["نَ",147,393]]],["بِهِۦ","thereby","onunla (ayaklarıyla)",1,[["بِ",0,4798],["هِۦ",113,10]]],["نَقْعًۭا","dust","toz",0,[["نَقْعًا",65,4172]]]],"en":"Stirring up thereby [clouds of] dust,","tr":"Ve tozu dumana katanlara;","de":"die darin Staub aufwirbeln,"},{"a":5,"w":[["فَوَسَطْنَ","Then penetrate (in the) center","derken dalanlara",1,[["فَ",10,4797],["وَسَطْ",417,4649],["نَ",147,393]]],["بِهِۦ","thereby","onunla",1,[["بِ",0,4798],["هِۦ",113,10]]],["جَمْعًا","collectively","bir topluluğa",0,[["جَمْعًا",65,672]]]],"en":"Arriving thereby in the center collectively,","tr":"Düşman topluluğunun içine dalanlara ki:","de":"die dann mitten in die Ansammlung eindringen!"},{"a":6,"w":[["إِنَّ","Indeed","şüphesiz",0,[["إِنَّ",44,4]]],["ٱلْإِنسَـٰنَ","mankind","insan",1,[["ٱلْ",3,4795],["إِنسَٰنَ",14,164]]],["لِرَبِّهِۦ","to his Lord","Rabbine karşı",1,[["لِ",0,4796],["رَبِّ",1,11],["هِۦ",29,10]]],["لَكَنُودٌۭ","(is) surely ungrateful","çok nankördür",1,[["لَ",106,4796],["كَنُودٌ",148,3707]]]],"en":"Indeed mankind, to his Lord, is ungrateful.","tr":"İnsan gerçekten Rabbine karşı pek nankördür.","de":"Der Mensch ist seinem Herrn gegenüber wahrlich undankbar,"},{"a":7,"w":[["وَإِنَّهُۥ","And indeed, he","ve elbette o da",1,[["وَ",10,4794],["إِنَّ",44,4],["هُۥ",29,10]]],["عَلَىٰ","on","buna",0,[["عَلَىٰ",19,7]]],["ذَٰلِكَ","that","",0,[["ذَٰ",25,21],["لِ",26,4796],["كَ",27,-1]]],["لَشَهِيدٌۭ","surely (is) a witness","şahiddir",1,[["لَ",106,4796],["شَهِيدٌ",148,208]]]],"en":"And indeed, he is to that a witness.","tr":"Doğrusu kendisi de bunların hepsine şahittir.","de":"und er (selbst) ist darüber wahrlich Zeuge."},{"a":8,"w":[["وَإِنَّهُۥ","And indeed he","doğrusu o",1,[["وَ",10,4794],["إِنَّ",44,4],["هُۥ",29,10]]],["لِحُبِّ","in (the) love","sevgisine",1,[["لِ",0,4796],["حُبِّ",1,880]]],["ٱلْخَيْرِ","(of) wealth","mal",1,[["ٱلْ",3,4795],["خَيْرِ",263,64]]],["لَشَدِيدٌ","(is) surely intense","aşırı düşkündür",1,[["لَ",106,4796],["شَدِيدٌ",148,207]]]],"en":"And indeed he is, in love of wealth, intense.","tr":"Gerçekten mala da pek düşkündür.","de":"Und er ist in seiner Liebe zum (eigenen) Besten wahrlich heftig."},{"a":9,"w":[["۞ أَفَلَا","But does not","bilmez mi?",2,[["أَ",82,4799],["فَ",76,4797],["لَا",22,3]]],["يَعْلَمُ","he know","",0,[["يَعْلَمُ",54,29]]],["إِذَا","when","zaman",0,[["إِذَا",67,26]]],["بُعْثِرَ","will be scattered","dışarı atıldığı",0,[["بُعْثِرَ",68,2678]]],["مَا","what","olanlar",0,[["مَا",35,8]]],["فِى","(is) in","kabirlerde",0,[["فِى",19,2]]],["ٱلْقُبُورِ","the graves","",1,[["ٱلْ",3,4795],["قُبُورِ",6,1183]]]],"en":"But does he not know that when the contents of the graves are scattered","tr":"İnsan, kabirlerde bulunanların çıkarılacağı ve kalblerde olanların ortaya konulacağı bir zamanın geleceğini bilmez mi?","de":"Weiß er denn nicht? Wenn durchwühlt wird, was in den Gräbern ist,"},{"a":10,"w":[["وَحُصِّلَ","And is made apparent","ve devşirildiği (zaman)",1,[["وَ",10,4794],["حُصِّلَ",391,4522]]],["مَا","what","bulunanlar",0,[["مَا",35,8]]],["فِى","(is) in","göğüslerde",0,[["فِى",19,2]]],["ٱلصُّدُورِ","the breasts","",1,[["ٱل",3,4795],["صُّدُورِ",6,258]]]],"en":"And that within the breasts is obtained,","tr":"İnsan, kabirlerde bulunanların çıkarılacağı ve kalblerde olanların ortaya konulacağı bir zamanın geleceğini bilmez mi?","de":"und herausgeholt wird, was in den Brüsten ist,..."},{"a":11,"w":[["إِنَّ","Indeed","şüphesiz",0,[["إِنَّ",44,4]]],["رَبَّهُم","their Lord","Rabbleri",0,[["رَبَّ",14,11],["هُم",20,12]]],["بِهِمْ","about them","onları",1,[["بِ",0,4798],["هِمْ",40,12]]],["يَوْمَئِذٍۢ","that Day","o gün",0,[["يَوْمَ",67,22],["ئِذٍ",67,52]]],["لَّخَبِيرٌۢ","(is) surely All-Aware","mutlaka haber almıştır",1,[["لَّ",106,4796],["خَبِيرٌۢ",148,253]]]],"en":"Indeed, their Lord with them, that Day, is [fully] Aware.","tr":"Doğrusu Rableri o gün onların her şeyinden haberdardır.","de":"ihr Herr wird an jenem Tag ihrer wahrlich Kundig sein."}]}