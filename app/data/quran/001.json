{"s":1,"v":[{"a":1,"w":[["بِسْمِ","In (the) name","adıyla",1,[["بِ",0,4798],["سْمِ",1,297]]],["ٱللَّهِ","(of) Allah","Allah'ın",0,[["ٱللَّهِ",2,1]]],["ٱلرَّحْمَـٰنِ","the Most Gracious","Rahman",1,[["ٱل",3,4795],["رَّحْمَٰنِ",4,202]]],["ٱلرَّحِيمِ","the Most Merciful","Rahim",1,[["ٱل",3,4795],["رَّحِيمِ",4,103]]]],"en":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","tr":"Rahman ve Rahim olan Allah'ın adıyla:","de":"Im Namen Allahs, des Allerbarmers, des Barmherzigen."},{"a":2,"w":[["ٱلْحَمْدُ","All praises and thanks","hamdolsun",1,[["ٱلْ",3,4795],["حَمْدُ",5,267]]],["لِلَّهِ","(be) to Allah","Allah'a",1,[["لِ",0,4796],["لَّهِ",2,1]]],["رَبِّ","the Lord","Rabbi",0,[["رَبِّ",1,11]]],["ٱلْعَـٰلَمِينَ","of the universe","Alemlerin",1,[["ٱلْ",3,4795],["عَٰلَمِينَ",6,158]]]],"en":"[All] praise is [due] to Allāh, Lord of the worlds -","tr":"Hamd, Alemlerin Rabbi Allah'a mahsustur.","de":"(Alles) Lob gehört Allah, dem Herrn der Welten,"},{"a":3,"w":[["ٱلرَّحْمَـٰنِ","The Most Gracious","(O) Rahman'dır",1,[["ٱل",3,4795],["رَّحْمَٰنِ",4,202]]],["ٱلرَّحِيمِ","the Most Merciful","Rahim'dir",1,[["ٱل",3,4795],["رَّحِيمِ",4,103]]]],"en":"The Entirely Merciful, the Especially Merciful,","tr":"O Rahman ve Rahim'dir,","de":"dem Allerbarmer, dem Barmherzigen,"},{"a":4,"w":[["مَـٰلِكِ","(The) Master","sahibidir",0,[["مَٰلِكِ",7,1562]]],["يَوْمِ","(of the) Day","gününün",0,[["يَوْمِ",1,22]]],["ٱلدِّينِ","(of the) Judgment","Din",1,[["ٱل",3,4795],["دِّينِ",1,118]]]],"en":"Sovereign of the Day of Recompense.","tr":"Din Gününün sahibidir.","de":"dem Herrscher am Tag des Gerichts."},{"a":5,"w":[["إِيَّاكَ","You Alone","ancak sana",0,[["إِيَّاكَ",8,433]]],["نَعْبُدُ","we worship","kulluk ederiz",0,[["نَعْبُدُ",9,100]]],["وَإِيَّاكَ","and You Alone","ancak senden",1,[["وَ",10,4794],["إِيَّاكَ",8,433]]],["نَسْتَعِينُ","we ask for help","yardım isteriz",0,[["نَسْتَعِينُ",11,1625]]]],"en":"It is You we worship and You we ask for help.","tr":"Ancak Sana kulluk eder ve yalnız Senden yardım dileriz.","de":"Dir allein dienen wir, und zu Dir allein flehen wir um Hilfe."},{"a":6,"w":[["ٱهْدِنَا","Guide us","bizi ilet",0,[["ٱهْدِ",12,85],["نَا",13,67]]],["ٱلصِّرَٰطَ","(to) the path","yola",1,[["ٱل",3,4795],["صِّرَٰطَ",14,254]]],["ٱلْمُسْتَقِيمَ","the straight","doğru",1,[["ٱلْ",3,4795],["مُسْتَقِيمَ",15,315]]]],"en":"Guide us to the straight path -","tr":"Bizi doğru yola eriştir.","de":"Leite uns den geraden Weg,"},{"a":7,"w":[["صِرَٰطَ","(The) path","yoluna",0,[["صِرَٰطَ",14,254]]],["ٱلَّذِينَ","(of) those","onlar ki",0,[["ٱلَّذِينَ",16,6]]],["أَنْعَمْتَ","You have bestowed (Your) Favors","ni'met verdin",0,[["أَنْعَمْ",17,570],["تَ",18,73]]],["عَلَيْهِمْ","on them","kimselerin",0,[["عَلَيْ",19,7],["هِمْ",20,12]]],["غَيْرِ","not (of)","değil",0,[["غَيْرِ",1,81]]],["ٱلْمَغْضُوبِ","those who earned (Your) wrath","gazabedilmiş olanların",1,[["ٱلْ",3,4795],["مَغْضُوبِ",21,3844]]],["عَلَيْهِمْ","on themselves","kendilerine",0,[["عَلَيْ",19,7],["هِمْ",20,12]]],["وَلَا","and not","ve değil",1,[["وَ",10,4794],["لَا",22,3]]],["ٱلضَّآلِّينَ","(of) those who go astray","sapmışların",1,[["ٱل",3,4795],["ضَّآلِّينَ",23,647]]]],"en":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","tr":"Nimete erdirdiğin kimselerin yoluna; gazaba uğrayanların, ya da sapıtanların yoluna değil.","de":"den Weg derjenigen, denen Du Gunst erwiesen hast, nicht derjenigen, die (Deinen) Zorn erregt haben, und nicht der Irregehenden!"}]}