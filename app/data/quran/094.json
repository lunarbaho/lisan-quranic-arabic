{"s":94,"v":[{"a":1,"w":[["أَلَمْ","Have not","açmadık mı?",1,[["أَ",82,4799],["لَمْ",22,32]]],["نَشْرَحْ","We expanded","",0,[["نَشْرَحْ",210,1413]]],["لَكَ","for you","senin",1,[["لَ",0,4796],["كَ",8,73]]],["صَدْرَكَ","your breast","göğsünü",0,[["صَدْرَ",14,258],["كَ",18,73]]]],"en":"Did We not expand for you, [O Muḥammad], your breast?","tr":"Senin gönlünü açmadık mı?","de":"Haben Wir dir nicht deine Brust aufgetan"},{"a":2,"w":[["وَوَضَعْنَا","And We removed","ve atmadık mı?",1,[["وَ",10,4794],["وَضَعْ",36,493],["نَا",13,67]]],["عَنكَ","from you","senin üzerinden",0,[["عَن",19,23],["كَ",18,73]]],["وِزْرَكَ","your burden","yükünü",0,[["وِزْرَ",33,725],["كَ",18,73]]]],"en":"And We removed from you your burden","tr":"Belini büken yükünü üzerinden almadık mı?","de":"und dir deine Last abgenommen,"},{"a":3,"w":[["ٱلَّذِىٓ","Which","(o yük) ki",0,[["ٱلَّذِىٓ",92,6]]],["أَنقَضَ","weighed upon","çatırdatmıştı",0,[["أَنقَضَ",80,4305]]],["ظَهْرَكَ","your back","sırtını",0,[["ظَهْرَ",14,614],["كَ",18,73]]]],"en":"Which had weighed upon your back","tr":"Belini büken yükünü üzerinden almadık mı?","de":"die deinen Rücken niederdrückte,"},{"a":4,"w":[["وَرَفَعْنَا","And We raised high","ve yükseltmedik mi?",1,[["وَ",10,4794],["رَفَعْ",36,471],["نَا",13,67]]],["لَكَ","for you","senin",1,[["لَ",0,4796],["كَ",8,73]]],["ذِكْرَكَ","your reputation","şanını",0,[["ذِكْرَ",102,147],["كَ",18,73]]]],"en":"And raised high for you your repute.","tr":"Senin şanını yükseltmedik mi?","de":"und dir dein Ansehen erhöht?"},{"a":5,"w":[["فَإِنَّ","So indeed","muhakkak (vardır)",1,[["فَ",10,4797],["إِنَّ",44,4]]],["مَعَ","with","beraber",0,[["مَعَ",84,71]]],["ٱلْعُسْرِ","the hardship","her güçlükle",1,[["ٱلْ",3,4795],["عُسْرِ",1,1319]]],["يُسْرًا","(is) ease","bir kolaylık",0,[["يُسْرًا",65,1095]]]],"en":"For indeed, with hardship [will be] ease [i.e., relief].","tr":"Elbette güçlükle beraber şüphesiz bir kolaylık vardır.","de":"Also gewiß, mit der Erschwernis ist Erleichterung,"},{"a":6,"w":[["إِنَّ","Indeed","elbette (vardır)",0,[["إِنَّ",44,4]]],["مَعَ","with","beraber",0,[["مَعَ",84,71]]],["ٱلْعُسْرِ","the hardship","her güçlükle",1,[["ٱلْ",3,4795],["عُسْرِ",1,1319]]],["يُسْرًۭا","(is) ease","bir kolaylık",0,[["يُسْرًا",65,1095]]]],"en":"Indeed, with hardship [will be] ease.","tr":"Gerçekten, güçlükle beraber bir kolaylık vardır.","de":"gewiß, mit der Erschwernis ist Erleichterung."},{"a":7,"w":[["فَإِذَا","So when","zaman",1,[["فَ",34,4797],["إِذَا",67,26]]],["فَرَغْتَ","you have finished","boşaldığın (işin bitince)",0,[["فَرَغْ",244,2743],["تَ",18,73]]],["فَٱنصَبْ","then labor hard","(tekrar) başla",1,[["فَ",119,4797],["ٱنصَبْ",12,2759]]]],"en":"So when you have finished [your duties], then stand up [for worship].","tr":"Öyleyse, bir işi bitirince diğerine giriş;","de":"Wenn du nun fertig bist, dann strenge dich an"},{"a":8,"w":[["وَإِلَىٰ","And to","ve",1,[["وَ",10,4794],["إِلَىٰ",19,15]]],["رَبِّكَ","your Lord","Rabb'ine",0,[["رَبِّ",1,11],["كَ",18,73]]],["فَٱرْغَب","turn your attention","niyaz et yalvar",1,[["فَ",10,4797],["ٱرْغَب",12,1676]]]],"en":"And to your Lord direct [your] longing.","tr":"Ve ümit edeceğini yalnız Rabbinden iste.","de":"und nach deinem Herrn richte dein Begehren aus."}]}