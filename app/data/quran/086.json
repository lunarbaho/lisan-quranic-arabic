{"s":86,"v":[{"a":1,"w":[["وَٱلسَّمَآءِ","By the sky","göğe andolsun",2,[["وَ",0,4794],["ٱل",3,4795],["سَّمَآءِ",72,37]]],["وَٱلطَّارِقِ","and the night comer","ve tarık'a",2,[["وَ",10,4794],["ٱل",3,4795],["طَّارِقِ",7,2365]]]],"en":"By the sky and the night comer","tr":"Göğe ve Tarık'a and olsun;","de":"Beim Himmel und dem Pochenden!"},{"a":2,"w":[["وَمَآ","And what","ve nedir?",1,[["وَ",10,4794],["مَآ",140,8]]],["أَدْرَىٰكَ","can make you know","sana bildiren",0,[["أَدْرَىٰ",80,569],["كَ",18,73]]],["مَا","what","nedir",0,[["مَا",140,8]]],["ٱلطَّارِقُ","the night comer (is)","tarık",1,[["ٱل",3,4795],["طَّارِقُ",316,2365]]]],"en":"And what can make you know what is the night comer?","tr":"Tarık'ın ne olduğunu sen bilir misin?","de":"Und was läßt dich wissen, was der Pochende ist?"},{"a":3,"w":[["ٱلنَّجْمُ","(It is) the star","yıldızdır",1,[["ٱل",3,4795],["نَّجْمُ",5,687]]],["ٱلثَّاقِبُ","the piercing","parlayan",1,[["ٱل",3,4795],["ثَّاقِبُ",1026,2202]]]],"en":"It is the piercing star","tr":"O, (ışığıyla karanlığı) delen yıldızdır.","de":"(Es ist) der durchbohrend helle Stem."},{"a":4,"w":[["إِن","Not","yoktur ki",0,[["إِن",22,16]]],["كُلُّ","(is) every","hiçbir",0,[["كُلُّ",5,31]]],["نَفْسٍۢ","soul","can",0,[["نَفْسٍ",196,38]]],["لَّمَّا","but","olmasın",0,[["لَّمَّا",155,787]]],["عَلَيْهَا","over it","başında",0,[["عَلَيْ",19,7],["هَا",125,61]]],["حَافِظٌۭ","(is) a protector","bir koruyucu",0,[["حَافِظٌ",150,673]]]],"en":"There is no soul but that it has over it a protector.","tr":"Üzerinde gözetici olmayan kimse yoktur.","de":"Es gibt keine Seele, über der nicht ein Hüter (eingesetzt) ist."},{"a":5,"w":[["فَلْيَنظُرِ","So let see","bir baksın",2,[["فَ",10,4797],["لْ",366,4796],["يَنظُرِ",315,126]]],["ٱلْإِنسَـٰنُ","man","insan",1,[["ٱلْ",3,4795],["إِنسَٰنُ",5,164]]],["مِمَّ","from what","neden",0,[["مِ",19,0],["مَّ",35,8]]],["خُلِقَ","he is created","yaratıldığına",0,[["خُلِقَ",68,62]]]],"en":"So let man observe from what he was created.","tr":"Öyleyse insan neden yaratıldığına bir baksın.","de":"So soll der Mensch doch hinsehen, woraus er erschaffen ist."},{"a":6,"w":[["خُلِقَ","He is created","yaratıldı",0,[["خُلِقَ",68,62]]],["مِن","from","bir sudan",0,[["مِن",19,0]]],["مَّآءٍۢ","a water","",0,[["مَّآءٍ",42,188]]],["دَافِقٍۢ","ejected","atılan",0,[["دَافِقٍ",1044,3198]]]],"en":"He was created from a fluid, ejected,","tr":"O, erkek ve kadının beli ile kaburga kemikleri arasından atılagelen bir sudan yaratılmıştır.","de":"Er ist aus sich ergießendem Wasser erschaffen,"},{"a":7,"w":[["يَخْرُجُ","Coming forth","çıkan",0,[["يَخْرُجُ",54,218]]],["مِنۢ","from","arasından",0,[["مِنۢ",19,0]]],["بَيْنِ","between","",0,[["بَيْنِ",38,46]]],["ٱلصُّلْبِ","the backbone","bel",1,[["ٱل",3,4795],["صُّلْبِ",1,2355]]],["وَٱلتَّرَآئِبِ","and the ribs","ve kaburga kemikleri",2,[["وَ",10,4794],["ٱل",3,4795],["تَّرَآئِبِ",6,3003]]]],"en":"Emerging from between the backbone and the ribs.","tr":"O, erkek ve kadının beli ile kaburga kemikleri arasından atılagelen bir sudan yaratılmıştır.","de":"das zwischen der Lende und der (weiblichen) Brust hervorkommt."},{"a":8,"w":[["إِنَّهُۥ","Indeed, He","şüphesiz O",0,[["إِنَّ",44,4],["هُۥ",29,10]]],["عَلَىٰ","to","onu tekrar döndürmeye",0,[["عَلَىٰ",19,7]]],["رَجْعِهِۦ","return him","",0,[["رَجْعِ",1,1784],["هِۦ",29,10]]],["لَقَادِرٌۭ","(is) Able","elbette kadirdir",1,[["لَ",106,4796],["قَادِرٌ",150,651]]]],"en":"Indeed, He [i.e., Allāh], to return him [to life], is Able.","tr":"Şüphesiz Allah, gizliliklerin ortaya çıkacağı gün, insanı tekrar yaratmaya Kadir'dir.","de":"Er hat die Macht dazu, ihn zurückkehren zu lassen,"},{"a":9,"w":[["يَوْمَ","(The) Day","gün",0,[["يَوْمَ",271,22]]],["تُبْلَى","will be tested","yoklanacağı",0,[["تُبْلَى",388,507]]],["ٱلسَّرَآئِرُ","the secrets","sırların",1,[["ٱل",3,4795],["سَّرَآئِرُ",248,3348]]]],"en":"The Day when secrets will be put on trial,","tr":"Şüphesiz Allah, gizliliklerin ortaya çıkacağı gün, insanı tekrar yaratmaya Kadir'dir.","de":"am Tag, da die geheimsten Gedanken geprüft werden."},{"a":10,"w":[["فَمَا","Then not","yoktur",1,[["فَ",10,4797],["مَا",22,14]]],["لَهُۥ","(is) for him","onun",1,[["لَ",0,4796],["هُۥ",113,10]]],["مِن","any","hiçbir",0,[["مِن",19,0]]],["قُوَّةٍۢ","power","gücü",0,[["قُوَّةٍ",120,363]]],["وَلَا","and not","ve ne de",1,[["وَ",10,4794],["لَا",22,3]]],["نَاصِرٍۢ","any helper","bir yardımcısı",0,[["نَاصِرٍ",250,781]]]],"en":"Then he [i.e., man] will have no power or any helper.","tr":"O gün, insanın gücü de, yardımcısı da olmaz.","de":"Dann hat er weder Kraft noch einen Helfer."},{"a":11,"w":[["وَٱلسَّمَآءِ","By the sky","göğe andolsun",2,[["وَ",0,4794],["ٱل",3,4795],["سَّمَآءِ",72,37]]],["ذَاتِ","which","dönüşlü",0,[["ذَاتِ",39,75]]],["ٱلرَّجْعِ","returns","",1,[["ٱل",3,4795],["رَّجْعِ",1,1784]]]],"en":"By the sky which sends back","tr":"Dönüşlü göğe ve yarılan yeryüzüne and olsun ki,","de":"Beim Himmel mit der Wiederkehr"},{"a":12,"w":[["وَٱلْأَرْضِ","And the earth","ve yere andolsun",2,[["وَ",10,4794],["ٱلْ",3,4795],["أَرْضِ",72,24]]],["ذَاتِ","which","çatlayan",0,[["ذَاتِ",39,75]]],["ٱلصَّدْعِ","cracks open","",1,[["ٱل",3,4795],["صَّدْعِ",1,3441]]]],"en":"And [by] the earth which splits,","tr":"Dönüşlü göğe ve yarılan yeryüzüne and olsun ki,","de":"und der Erde mit ihren Sprüngen!"},{"a":13,"w":[["إِنَّهُۥ","Indeed, it","elbette O",0,[["إِنَّ",44,4],["هُۥ",29,10]]],["لَقَوْلٌۭ","(is) surely a Word","muhakkak bir sözdür",1,[["لَ",106,4796],["قَوْلٌ",359,119]]],["فَصْلٌۭ","decisive","ayırdedici",0,[["فَصْلٌ",237,900]]]],"en":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","tr":"Doğrusu bu Kuran kesin bir sözdür.","de":"Er ist wahrlich ein entscheidendes Wort;"},{"a":14,"w":[["وَمَا","And not","ve değildir",1,[["وَ",10,4794],["مَا",57,14]]],["هُوَ","it","O",0,[["هُوَ",113,10]]],["بِٱلْهَزْلِ","(is) for amusement","şaka",2,[["بِ",0,4798],["ٱلْ",3,4795],["هَزْلِ",1,4197]]]],"en":"And it is not amusement.","tr":"O, eğlence için değildir.","de":"er ist kein Scherz."},{"a":15,"w":[["إِنَّهُمْ","Indeed, they","elbette onlar",0,[["إِنَّ",44,4],["هُمْ",20,12]]],["يَكِيدُونَ","are plotting","kuruyorlar",0,[["يَكِيدُ",62,1013],["ونَ",20,12]]],["كَيْدًۭا","a plot","bir tuzak",0,[["كَيْدًا",65,416]]]],"en":"Indeed, they are planning a plan,","tr":"Gerçekten onlar düzen kuruyorlar.","de":"Sie wenden eine List an,"},{"a":16,"w":[["وَأَكِيدُ","But I am planning","ben de kuruyorum",1,[["وَ",10,4794],["أَكِيدُ",153,1013]]],["كَيْدًۭا","a plan","bir tuzak",0,[["كَيْدًا",65,416]]]],"en":"But I am planning a plan.","tr":"Ben de bir düzen kurmaktayım.","de":"Und Ich wende eine List an."},{"a":17,"w":[["فَمَهِّلِ","So give respite","o halde mühlet ver",1,[["فَ",34,4797],["مَهِّلِ",127,2753]]],["ٱلْكَـٰفِرِينَ","(to) the disbelievers","kafirlere",1,[["ٱلْ",3,4795],["كَٰفِرِينَ",121,76]]],["أَمْهِلْهُمْ","Give respite to them ","kendi hallerine bırak",0,[["أَمْهِلْ",160,4304],["هُمْ",20,12]]],["رُوَيْدًۢا","little","birazcık",0,[["رُوَيْدًۢا",65,3281]]]],"en":"So allow time for the disbelievers. Leave them awhile.","tr":"Sen inkarcılara mehil ver; onlara mukabeleyi biraz geri bırak.","de":"So lasse den Ungläubigen noch Zeit; lasse ihnen nur eine Weile Zeit."}]}