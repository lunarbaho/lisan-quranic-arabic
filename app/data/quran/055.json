{"s":55,"v":[{"a":1,"w":[["ٱلرَّحْمَـٰنُ","The Most Gracious","Çok merhametli (Allah)",1,[["ٱل",3,4795],["رَّحْمَٰنُ",158,202]]]],"en":"The Most Merciful","tr":"Rahman olan Allah Kuran'ı öğretti;","de":"Der Allerbarmer"},{"a":2,"w":[["عَلَّمَ","He taught","öğretti",0,[["عَلَّمَ",146,282]]],["ٱلْقُرْءَانَ","the Quran","Kur'an'ı",1,[["ٱلْ",3,4795],["قُرْءَانَ",154,171]]]],"en":"Taught the Qur’ān,","tr":"Rahman olan Allah Kuran'ı öğretti;","de":"hat den Qur’an gelehrt."},{"a":3,"w":[["خَلَقَ","He created","yarattı",0,[["خَلَقَ",49,62]]],["ٱلْإِنسَـٰنَ","[the] man","insanı",1,[["ٱلْ",3,4795],["إِنسَٰنَ",14,164]]]],"en":"Created man,","tr":"İnsanı yarattı, ona konuşmayı öğretti.","de":"Er hat den Menschen erschaffen."},{"a":4,"w":[["عَلَّمَهُ","He taught him","ona öğretti",0,[["عَلَّمَ",146,282],["هُ",29,10]]],["ٱلْبَيَانَ","[the] speech","beyanı",1,[["ٱلْ",3,4795],["بَيَانَ",14,1729]]]],"en":"[And] taught him eloquence.","tr":"İnsanı yarattı, ona konuşmayı öğretti.","de":"Er hat ihn die klare Darlegung gelehrt."},{"a":5,"w":[["ٱلشَّمْسُ","The sun","güneş",1,[["ٱل",3,4795],["شَّمْسُ",90,340]]],["وَٱلْقَمَرُ","and the moon","ve ay",2,[["وَ",10,4794],["ٱلْ",3,4795],["قَمَرُ",5,397]]],["بِحُسْبَانٍۢ","by (precise) calculation","bir hesap iledir",1,[["بِ",0,4798],["حُسْبَانٍ",42,1758]]]],"en":"The sun and the moon [move] by precise calculation,","tr":"Güneş ve ayın hareketleri bir hesaba göredir.","de":"Die Sonne und der Mond (laufen) nach Berechnung."},{"a":6,"w":[["وَٱلنَّجْمُ","And the stars","necm (bitkiler-yıldızlar)",2,[["وَ",10,4794],["ٱل",3,4795],["نَّجْمُ",5,687]]],["وَٱلشَّجَرُ","and the trees","ve ağaçlar",2,[["وَ",10,4794],["ٱل",3,4795],["شَّجَرُ",5,1063]]],["يَسْجُدَانِ","both prostrate","secde etmektedirler",0,[["يَسْجُدَ",564,332],["انِ",175,578]]]],"en":"And the stars and trees prostrate.","tr":"Bitkiler ve ağaçlar O'nun buyruğuna boyun eğerler.","de":"Die stiellosen Pflanzen und die Bäume werfen sich nieder."},{"a":7,"w":[["وَٱلسَّمَآءَ","And the heaven","ve göğü",2,[["وَ",10,4794],["ٱل",3,4795],["سَّمَآءَ",33,37]]],["رَفَعَهَا","He raised it","yükseltti",0,[["رَفَعَ",49,471],["هَا",125,61]]],["وَوَضَعَ","and He has set up","ve koydu",1,[["وَ",10,4794],["وَضَعَ",49,493]]],["ٱلْمِيزَانَ","the balance","mizanı",1,[["ٱلْ",3,4795],["مِيزَانَ",14,589]]]],"en":"And the heaven He raised and imposed the balance","tr":"O, göğü yükseltmiştir; tartıyı koymuştur.","de":"Den Himmel hat Er emporgehoben und die Waage aufgestellt,"},{"a":8,"w":[["أَلَّا","That not","taşkınlık etmeyin",0,[["أَ",317,18],["لَّا",69,3]]],["تَطْغَوْا۟","you may transgress","",0,[["تَطْغَ",114,742],["وْا۟",71,20]]],["فِى","in","tartıda",0,[["فِى",19,2]]],["ٱلْمِيزَانِ","the balance","",1,[["ٱلْ",3,4795],["مِيزَانِ",1,589]]]],"en":"That you not transgress within the balance.","tr":"Artık tartıda tecavüz etmeyin.","de":"damit ihr beim Wägen nicht das Maß überschreitet."},{"a":9,"w":[["وَأَقِيمُوا۟","And establish","ve yapın",1,[["وَ",10,4794],["أَقِيمُ",78,215],["وا۟",71,20]]],["ٱلْوَزْنَ","the weight","tartıyı",1,[["ٱلْ",3,4795],["وَزْنَ",14,1959]]],["بِٱلْقِسْطِ","in justice","adaletle",2,[["بِ",0,4798],["ٱلْ",3,4795],["قِسْطِ",1,615]]],["وَلَا","and (do) not","ve",1,[["وَ",10,4794],["لَا",69,3]]],["تُخْسِرُوا۟","make deficient","eksiklik yapmayın",0,[["تُخْسِرُ",70,2812],["وا۟",71,20]]],["ٱلْمِيزَانَ","the balance","terazide",1,[["ٱلْ",3,4795],["مِيزَانَ",14,589]]]],"en":"And establish weight in justice and do not make deficient the balance.","tr":"Tartmayı doğru yapın, tartıyı eksik tutmayın.","de":"Und meßt das Gewicht in Gerechtigkeit und gebt beim Wägen nicht weniger."},{"a":10,"w":[["وَٱلْأَرْضَ","And the earth","ve yeryüzünü",2,[["وَ",10,4794],["ٱلْ",3,4795],["أَرْضَ",33,24]]],["وَضَعَهَا","He laid it","koydu",0,[["وَضَعَ",49,493],["هَا",125,61]]],["لِلْأَنَامِ","for the creatures","canlılar için",2,[["لِ",0,4796],["لْ",3,4795],["أَنَامِ",1,2891]]]],"en":"And the earth He laid [out] for the creatures.","tr":"Allah, yeri yaratıkları için meydana getirmiştir.","de":"Und die Erde hat Er für die Geschöpfe (an)gelegt;"},{"a":11,"w":[["فِيهَا","Therein","onda vardır",0,[["فِي",19,2],["هَا",125,61]]],["فَـٰكِهَةٌۭ","(is) fruit","meyva(lar)",0,[["فَٰكِهَةٌ",52,771]]],["وَٱلنَّخْلُ","and date-palms","ve hurmalar",2,[["وَ",10,4794],["ٱل",3,4795],["نَّخْلُ",5,783]]],["ذَاتُ","having","salkımlı",0,[["ذَاتُ",208,75]]],["ٱلْأَكْمَامِ","sheaths","",1,[["ٱلْ",3,4795],["أَكْمَامِ",6,2132]]]],"en":"Therein is fruit and palm trees having sheaths [of dates]","tr":"Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır.","de":"auf ihr gibt es Früchte, Palmen mit Fruchthüllen"},{"a":12,"w":[["وَٱلْحَبُّ","And the grain","ve dane(ler)",2,[["وَ",10,4794],["ٱلْ",3,4795],["حَبُّ",5,1044]]],["ذُو","having","saplı ve yapraklı",0,[["ذُو",157,75]]],["ٱلْعَصْفِ","husk","",1,[["ٱلْ",3,4795],["عَصْفِ",1,1834]]],["وَٱلرَّيْحَانُ","and scented plants","ve hoş kokulu bitkiler",2,[["وَ",10,4794],["ٱل",3,4795],["رَّيْحَانُ",1,2296]]]],"en":"And grain having husks and scented plants.","tr":"Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır.","de":"und Korn mit Halmen und duftende Pflanzen."},{"a":13,"w":[["فَبِأَىِّ","So which","şimdi hangi?",2,[["فَ",34,4797],["بِ",0,4798],["أَىِّ",735,55]]],["ءَالَآءِ","(of the) favors","ni'metlerini",0,[["ءَالَآءِ",6,335]]],["رَبِّكُمَا","(of) your Lord","Rabbinizin",0,[["رَبِّ",1,11],["كُمَا",167,943]]],["تُكَذِّبَانِ","will you both deny","yalanlıyorsunuz",0,[["تُكَذِّبَ",1010,66],["انِ",167,943]]]],"en":"So which of the favors of your Lord would you deny?","tr":"Ey insanlar ve cinler! Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","de":"Welche der Wohltaten eures Herrn wollt ihr beide denn leugnen?"},{"a":14,"w":[["خَلَقَ","He created","yarattı",0,[["خَلَقَ",49,62]]],["ٱلْإِنسَـٰنَ","the man","insanı",1,[["ٱلْ",3,4795],["إِنسَٰنَ",14,164]]],["مِن","from","pişmiş çamurdan",0,[["مِن",19,0]]],["صَلْصَـٰلٍۢ","clay","",0,[["صَلْصَٰلٍ",42,1517]]],["كَٱلْفَخَّارِ","like the pottery","kiremit gibi",2,[["كَ",0,4802],["ٱلْ",3,4795],["فَخَّارِ",263,3616]]]],"en":"He created man from clay like [that of] pottery.","tr":"O, insanı pişmiş çamur gibi kuru balçıktan yaratmıştır.","de":"Er hat den Menschen aus trockenem Ton wie Töpferware erschaffen."},{"a":15,"w":[["وَخَلَقَ","And He created","ve yarattı",1,[["وَ",10,4794],["خَلَقَ",49,62]]],["ٱلْجَآنَّ","the jinn","cin'i",1,[["ٱلْ",3,4795],["جَآنَّ",489,1040]]],["مِن","from","dumanı olmayan alevden",0,[["مِن",19,0]]],["مَّارِجٍۢ","a smokeless flame","",0,[["مَّارِجٍ",250,3752]]],["مِّن","of","ateşten",0,[["مِّن",19,0]]],["نَّارٍۢ","fire","",0,[["نَّارٍ",120,83]]]],"en":"And He created the jinn from a smokeless flame of fire.","tr":"Cinleri de yalın bir alevden yaratmıştır.","de":"Und Er hat die Ginn aus einer unruhigen Feuerflamme erschaffen."},{"a":16,"w":[["فَبِأَىِّ","So which","şimdi hangi?",2,[["فَ",34,4797],["بِ",0,4798],["أَىِّ",735,55]]],["ءَالَآءِ","(of the) favors","ni'metlerini",0,[["ءَالَآءِ",6,335]]],["رَبِّكُمَا","(of) your Lord","Rabbinizin",0,[["رَبِّ",1,11],["كُمَا",167,943]]],["تُكَذِّبَانِ","will you both deny","yalanlıyorsunuz",0,[["تُكَذِّبَ",1010,66],["انِ",167,943]]]],"en":"So which of the favors of your Lord would you deny?","tr":"Öyleyken; Rabbinizin nimetlerinden hangisini yalanlarsınız?","de":"Welche der Wohltaten eures Herrn wollt ihr beide denn leugnen?"},{"a":17,"w":[["رَبُّ","Lord","Rabbidir",0,[["رَبُّ",5,11]]],["ٱلْمَشْرِقَيْنِ","(of) the two Easts","iki doğunun",1,[["ٱلْ",3,4795],["مَشْرِقَيْنِ",543,778]]],["وَرَبُّ","and Lord","ve Rabbidir",1,[["وَ",10,4794],["رَبُّ",5,11]]],["ٱلْمَغْرِبَيْنِ","(of) the two Wests","iki batının",1,[["ٱلْ",3,4795],["مَغْرِبَيْنِ",543,836]]]],"en":"[He is] Lord of the two sunrises and Lord of the two sunsets.","tr":"O, iki doğunun Rabbidir, iki batının Rabbidir.","de":"(Er ist) der Herr der beiden Osten und der Herr der beiden Westen."},{"a":18,"w":[["فَبِأَىِّ","So which","şimdi hangi?",2,[["فَ",34,4797],["بِ",0,4798],["أَىِّ",735,55]]],["ءَالَآءِ","(of the) favors","ni'metlerini",0,[["ءَالَآءِ",6,335]]],["رَبِّكُمَا","(of) your Lord","Rabbinizin",0,[["رَبِّ",1,11],["كُمَا",167,943]]],["تُكَذِّبَانِ","will you both deny","yalanlıyorsunuz",0,[["تُكَذِّبَ",1010,66],["انِ",167,943]]]],"en":"So which of the favors of your Lord would you deny?","tr":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","de":"Welche der Wohltaten eures Herrn wollt ihr beide denn leugnen?"},{"a":19,"w":[["مَرَجَ","He released","salıverdi",0,[["مَرَجَ",49,2752]]],["ٱلْبَحْرَيْنِ","the two seas","iki denizi",1,[["ٱلْ",3,4795],["بَحْرَيْنِ",456,277]]],["يَلْتَقِيَانِ","meeting","birbirine kavuşuyorlar",0,[["يَلْتَقِيَ",782,1103],["انِ",175,578]]]],"en":"He released the two seas, meeting [one another];","tr":"Acı ve tatlı sulu iki denizi birbirine kavuşmamak üzere salıvermiştir.","de":"Er hat den beiden Meeren freien Lauf gelassen; sie treffen aufeinander,"},{"a":20,"w":[["بَيْنَهُمَا","Between both of them","aralarında vardır",0,[["بَيْنَ",84,46],["هُمَا",175,578]]],["بَرْزَخٌۭ","(is) a barrier","bir engel",0,[["بَرْزَخٌ",30,1723]]],["لَّا","not","(birbirine) geçip karışmıyorlar",0,[["لَّا",22,3]]],["يَبْغِيَانِ","they transgress","",0,[["يَبْغِيَ",564,426],["انِ",175,578]]]],"en":"Between them is a barrier so neither of them transgresses.","tr":"Aralarında bir engel vardır; birbirinin sınırını aşamazlar.","de":"zwischen ihnen ist (aber) ein trennendes Hindernis, (das)s sie (ihre Grenzen) nicht überschreiten."},{"a":21,"w":[["فَبِأَىِّ","So which","şimdi hangi?",2,[["فَ",34,4797],["بِ",0,4798],["أَىِّ",735,55]]],["ءَالَآءِ","(of the) favors","ni'metlerini",0,[["ءَالَآءِ",6,335]]],["رَبِّكُمَا","(of) your Lord","Rabbinizin",0,[["رَبِّ",1,11],["كُمَا",167,943]]],["تُكَذِّبَانِ","will you both deny","yalanlıyorsunuz",0,[["تُكَذِّبَ",1010,66],["انِ",167,943]]]],"en":"So which of the favors of your Lord would you deny?","tr":"Öyleyken, Rabbinizin nimetlerinden hangisi