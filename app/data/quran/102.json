{"s":102,"v":[{"a":1,"w":[["أَلْهَىٰكُمُ","Diverts you","sizi oyaladı",0,[["أَلْهَىٰ",80,1613],["كُمُ",71,20]]],["ٱلتَّكَاثُرُ","the competition to increase","çokluk yarışı",1,[["ٱل",3,4795],["تَّكَاثُرُ",822,2195]]]],"en":"Competition in [worldly] increase diverts you","tr":"Çoğunluk olmak iddianız sizi o kadar meşgul etti ki, mezarları ziyaretle oradakileri de sayacak kadar oldunuz.","de":"Die Vermehrung lenkt euch ab,"},{"a":2,"w":[["حَتَّىٰ","Until","nihayet",0,[["حَتَّىٰ",540,86]]],["زُرْتُمُ","you visit","ziyaret ettiniz",0,[["زُرْ",204,4543],["تُمُ",71,20]]],["ٱلْمَقَابِرَ","the graves","kabirleri",1,[["ٱلْ",3,4795],["مَقَابِرَ",101,3849]]]],"en":"Until you visit the graveyards.","tr":"Çoğunluk olmak iddianız sizi o kadar meşgul etti ki, mezarları ziyaretle oradakileri de sayacak kadar oldunuz.","de":"bis ihr die Friedhöfe besucht."},{"a":3,"w":[["كَلَّا","Nay","hayır",0,[["كَلَّا",875,344]]],["سَوْفَ","Soon","yakında",0,[["سَوْفَ",580,273]]],["تَعْلَمُونَ","you will know","bileceksiniz",0,[["تَعْلَمُ",116,29],["ونَ",71,20]]]],"en":"No! You are going to know.","tr":"Hayır; öyle olmayın; yakında bileceksiniz.","de":"Keineswegs! Ihr werdet (es noch) erfahren."},{"a":4,"w":[["ثُمَّ","Then","sonra",0,[["ثُمَّ",47,34]]],["كَلَّا","nay","hayır",0,[["كَلَّا",875,344]]],["سَوْفَ","Soon","yakında",0,[["سَوْفَ",580,273]]],["تَعْلَمُونَ","you will know","bileceksiniz",0,[["تَعْلَمُ",116,29],["ونَ",71,20]]]],"en":"Then, no! You are going to know.","tr":"Hayır; gözünüzü açın; yakında bileceksiniz.","de":"Abermals: Keineswegs! Ihr werdet (es noch) erfahren."},{"a":5,"w":[["كَلَّا","Nay","hayır",0,[["كَلَّا",875,344]]],["لَوْ","If","keşke",0,[["لَوْ",105,58]]],["تَعْلَمُونَ","you know","bilseydiniz",0,[["تَعْلَمُ",116,29],["ونَ",71,20]]],["عِلْمَ","(with) a knowledge","bilgi ile",0,[["عِلْمَ",14,111]]],["ٱلْيَقِينِ","(of) certainty","kesin",1,[["ٱلْ",3,4795],["يَقِينِ",263,986]]]],"en":"No! If you only knew with knowledge of certainty...","tr":"Dikkat edin, şayet yaptığınızın sonucunu kesin olarak bir bilseniz!","de":"Keineswegs! Wenn ihr es nur mit dem Wissen der Gewißheit wüßtet!"},{"a":6,"w":[["لَتَرَوُنَّ","Surely you will see","mutlaka görürdünüz",1,[["لَ",106,4796],["تَرَوُ",116,45],["نَّ",181,4803]]],["ٱلْجَحِيمَ","the Hellfire","cehennemi",1,[["ٱلْ",3,4795],["جَحِيمَ",33,412]]]],"en":"You will surely see the Hellfire.","tr":"And olsun ki, cehennemi göreceksiniz.","de":"Ihr werdet ganz gewiß den Höllenbrand sehen."},{"a":7,"w":[["ثُمَّ","Then","sonra",0,[["ثُمَّ",47,34]]],["لَتَرَوُنَّهَا","surely you will see it","onu göreceksiniz",1,[["لَ",106,4796],["تَرَوُ",116,45],["نَّ",181,4803],["هَا",125,61]]],["عَيْنَ","(with the) eye","gözle",0,[["عَيْنَ",33,203]]],["ٱلْيَقِينِ","(of) certainty","kesin olarak",1,[["ٱلْ",3,4795],["يَقِينِ",263,986]]]],"en":"Then you will surely see it with the eye of certainty.","tr":"And olsun ki, onu gözünüzle kesin olarak göreceksiniz.","de":"Abermals: Ihr werdet ihn mit dem Auge der Gewißheit sehen."},{"a":8,"w":[["ثُمَّ","Then","sonra",0,[["ثُمَّ",47,34]]],["لَتُسْـَٔلُنَّ","surely you will be asked","sorulacaksınız",1,[["لَ",106,4796],["تُسْـَٔلُ",144,108],["نَّ",181,4803]]],["يَوْمَئِذٍ","that Day","o gün",0,[["يَوْمَ",67,22],["ئِذٍ",67,52]]],["عَنِ","about","ni'metlerden",0,[["عَنِ",19,23]]],["ٱلنَّعِيمِ","the pleasures","",1,[["ٱل",3,4795],["نَّعِيمِ",1,567]]]],"en":"Then you will surely be asked that Day about pleasure.","tr":"Sonra o gün, size verilmiş olan her nimetten sorguya çekileceksiniz.","de":"Hierauf werdet ihr an jenem Tag ganz gewiß nach der Wonne gefragt werden."}]}