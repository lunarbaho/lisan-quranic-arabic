{"s":87,"v":[{"a":1,"w":[["سَبِّحِ","Glorify","tesbih et",0,[["سَبِّحِ",127,276]]],["ٱسْمَ","(the) name","adını",0,[["ٱسْمَ",14,297]]],["رَبِّكَ","(of) your Lord","Rabbinin",0,[["رَبِّ",1,11],["كَ",18,73]]],["ٱلْأَعْلَى","the Most High","yüce",1,[["ٱلْ",3,4795],["أَعْلَى",339,872]]]],"en":"Exalt the name of your Lord, the Most High,","tr":"Yüce Rabbinin adını tesbih et.","de":"Preise den Namen deines höchsten Herrn,"},{"a":2,"w":[["ٱلَّذِى","The One Who","O ki",0,[["ٱلَّذِى",92,6]]],["خَلَقَ","created","yarattı",0,[["خَلَقَ",49,62]]],["فَسَوَّىٰ","then proportioned","düzenledi",1,[["فَ",10,4797],["سَوَّىٰ",146,693]]]],"en":"Who created and proportioned","tr":"O, yaratıp şekil vermiştir.","de":"Der erschafft und dann zurechtformt"},{"a":3,"w":[["وَٱلَّذِى","And the One Who","ve O ki",1,[["وَ",10,4794],["ٱلَّذِى",92,6]]],["قَدَّرَ","measured","takdie etti",0,[["قَدَّرَ",146,601]]],["فَهَدَىٰ","then guided","hedefini gösterdi",1,[["فَ",10,4797],["هَدَىٰ",49,85]]]],"en":"And who destined and [then] guided","tr":"O, her şeyi ölçüyle yapıp doğru yolu göstermiştir.","de":"und Der das Maß festsetzt und dann rechtleitet"},{"a":4,"w":[["وَٱلَّذِىٓ","And the One Who","ve O ki",1,[["وَ",10,4794],["ٱلَّذِىٓ",92,6]]],["أَخْرَجَ","brings forth","çıkardı",0,[["أَخْرَجَ",80,114]]],["ٱلْمَرْعَىٰ","the pasture","otlağı",1,[["ٱلْ",3,4795],["مَرْعَىٰ",14,2493]]]],"en":"And who brings out the pasture","tr":"O, yeşillikler bitirmiştir.","de":"und Der die Weide hervorbringt"},{"a":5,"w":[["فَجَعَلَهُۥ","And then makes it","sonra da onu çevirdi",1,[["فَ",10,4797],["جَعَلَ",49,33],["هُۥ",29,10]]],["غُثَآءً","stubble","bir çöpe",0,[["غُثَآءً",65,2423]]],["أَحْوَىٰ","dark","kupkuru siyah",0,[["أَحْوَىٰ",191,2854]]]],"en":"And [then] makes it black stubble.","tr":"Sonra da onları siyah çerçöpe çevirmiştir.","de":"und sie dann zu dunkelbrauner Spreu macht."},{"a":6,"w":[["سَنُقْرِئُكَ","We will make you recite","sana okutacağız",1,[["سَ",212,4804],["نُقْرِئُ",83,4640],["كَ",18,73]]],["فَلَا","so not","unutmayacaksın",1,[["فَ",34,4797],["لَا",22,3]]],["تَنسَىٰٓ","you will forget","",0,[["تَنسَىٰٓ",151,333]]]],"en":"We will make you recite, [O Muḥammad], and you will not forget,","tr":"Sana Kuran'ı Biz okutacağız ve asla unutmayacaksın;","de":"Wir werden dich lesen lassen, und dann wirst du nichts vergessen,"},{"a":7,"w":[["إِلَّا","Except","yalnız başka",0,[["إِلَّا",155,17]]],["مَا","what","dilediği",0,[["مَا",35,8]]],["شَآءَ","wills","",0,[["شَآءَ",49,53]]],["ٱللَّهُ ۚ","Allah","Allah'ın",0,[["ٱللَّهُ",50,1]]],["إِنَّهُۥ","Indeed, He","muhakkak O",0,[["إِنَّ",44,4],["هُۥ",29,10]]],["يَعْلَمُ","knows","bilir",0,[["يَعْلَمُ",54,29]]],["ٱلْجَهْرَ","the manifest","açığı",1,[["ٱلْ",3,4795],["جَهْرَ",14,1043]]],["وَمَا","and what","ve olanı",1,[["وَ",10,4794],["مَا",35,8]]],["يَخْفَىٰ","is hidden","gizli",0,[["يَخْفَىٰ",54,1248]]]],"en":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","tr":"Allah'ın dilediği bundan müstesnadır. Doğrusu açığı da, gizliyi de bilen O'dur.","de":"außer dem, was Allah will. Er weiß ja, was laut vernehmbar geäußert wird und was verborgen bleibt."},{"a":8,"w":[["وَنُيَسِّرُكَ","And We will ease you","ve sana kolaylaştıracağız",1,[["وَ",10,4794],["نُيَسِّرُ",152,802],["كَ",18,73]]],["لِلْيُسْرَىٰ","to the ease","en kolay olana",2,[["لِ",0,4796],["لْ",3,4795],["يُسْرَىٰ",39,2622]]]],"en":"And We will ease you toward ease.","tr":"Kolay olanı yapmayı sana kolaylaştırırız.","de":"Und Wir werden dir den Weg zum Leichteren leicht machen."},{"a":9,"w":[["فَذَكِّرْ","So remind","o halde hatırlat öğüt ver",1,[["فَ",34,4797],["ذَكِّرْ",127,547]]],["إِن","if","eğer",0,[["إِن",105,16]]],["نَّفَعَتِ","benefits","yarar verirse",0,[["نَّفَعَتِ",89,359]]],["ٱلذِّكْرَىٰ","the reminder","hatırlatmak",1,[["ٱل",3,4795],["ذِّكْرَىٰ",90,444]]]],"en":"So remind, if the reminder should benefit;","tr":"Faydalı olacaksa insanlara öğüt ver.","de":"So ermahne -, wenn die Ermahnung nützt."},{"a":10,"w":[["سَيَذَّكَّرُ","He will pay heed ","hatırlar",1,[["سَ",212,4804],["يَذَّكَّرُ",249,228]]],["مَن","(one) who","olan",0,[["مَن",35,13]]],["يَخْشَىٰ","fears (Allah)","saygılı",0,[["يَخْشَىٰ",54,295]]]],"en":"He who fears [Allāh] will be reminded.","tr":"Allah'tan korkan öğüt alacaktır.","de":"Bedenken wird jemand, der gottesfürchtig ist."},{"a":11,"w":[["وَيَتَجَنَّبُهَا","And will avoid it","ve ondan kaçınır",1,[["وَ",10,4794],["يَتَجَنَّبُ",249,4661],["هَا",125,61]]],["ٱلْأَشْقَى","the wretched one","bahtsız olan",1,[["ٱلْ",3,4795],["أَشْقَى",157,1701]]]],"en":"But the wretched one will avoid it","tr":"Bedbaht olan ondan kaçınacaktır.","de":"Meiden aber wird es der Unseligste,"},{"a":12,"w":[["ٱلَّذِى","The one who","o ki",0,[["ٱلَّذِى",92,6]]],["يَصْلَى","will burn","girer",0,[["يَصْلَى",54,699]]],["ٱلنَّارَ","(in) the Fire","ateşe",1,[["ٱل",3,4795],["نَّارَ",33,83]]],["ٱلْكُبْرَىٰ","[the] great","en büyük",1,[["ٱلْ",3,4795],["كُبْرَىٰ",882,1078]]]],"en":"[He] who will [enter and] burn in the greatest Fire,","tr":"O, en büyük ateşe yaslanacaktır.","de":"der dem größten (Höllen)feuer ausgesetzt sein wird;"},{"a":13,"w":[["ثُمَّ","Then","sonra",0,[["ثُمَّ",47,34]]],["لَا","not","yoktur",0,[["لَا",22,3]]],["يَمُوتُ","he will die","ölüm",0,[["يَمُوتُ",54,303]]],["فِيهَا","therein","orada",0,[["فِي",19,2],["هَا",125,61]]],["وَلَا","and not","ve ne de",1,[["وَ",10,4794],["لَا",22,3]]],["يَحْيَىٰ","will live","yaşam",0,[["يَحْيَىٰ",54,1109]]]],"en":"Neither dying therein nor living.","tr":"O, orada ne ölecektir ne de dirilecektir.","de":"darin wird er hierauf weder sterben noch leben."},{"a":14,"w":[["قَدْ","Certainly","doğrusu",0,[["قَدْ",217,25]]],["أَفْلَحَ","has succeeded","kurtuluşa ermiştir",0,[["أَفْلَحَ",80,402]]],["مَن","(one) who","kimse",0,[["مَن",35,13]]],["تَزَكَّىٰ","purifies (himself)","nefsini arındıran",0,[["تَزَكَّىٰ",179,1000]]]],"en":"He has certainly succeeded who purifies himself","tr":"Arınmış olan, Rabbinin adını anıp namaz kılan, saadete erişecektir.","de":"Wohl ergehen wird es ja jemandem, der sich läutert,"},{"a":15,"w":[["وَذَكَرَ","And remembers","ve anan",1,[["وَ",10,4794],["ذَكَرَ",49,132]]],["ٱسْمَ","(the) name","adını",0,[["ٱسْمَ",14,297]]],["رَبِّهِۦ","(of) his Lord","Rabbinin",0,[["رَبِّ",1,11],["هِۦ",29,10]]],["فَصَلَّىٰ","and prays","ve namaz kılan",1,[["فَ",10,4797],["صَلَّىٰ",146,741]]]],"en":"And mentions the name of his Lord and prays.","tr":"Arınmış olan, Rabbinin adını anıp namaz kılan, saadete erişecektir.","de":"und des Namens seines Herrn gedenkt; so betet er."},{"a":16,"w":[["بَلْ","Nay","ama",0,[["بَلْ",277,97]]],["تُؤْثِرُونَ","You prefer","siz yeğliyorsunuz",0,[["تُؤْثِرُ",162,1370],["ونَ",71,20]]],["ٱلْحَيَوٰةَ","the life","hayatını",1,[["ٱلْ",3,4795],["حَيَوٰةَ",33,146]]],["ٱلدُّنْيَا","(of) the world","dünya",1,[["ٱل",3,4795],["دُّنْيَا",272,104]]]],"en":"But you prefer the worldly life,","tr":"Ama sizler dünya hayatını tercih ediyorsunuz.","de":"Nein! Vielmehr zieht ihr das diesseitige Leben vor,"},{"a":17,"w":[["وَٱلْـَٔاخِرَةُ","While the Hereafter","oysa ahiret",2,[["وَ",10,4794],["ٱلْ",3,4795],["ءَاخِرَةُ",208,77]]],["خَيْرٌۭ","(is) better","daha iyidir",0,[["خَيْرٌ",148,64]]],["وَأَبْقَىٰٓ","and everlasting","ve daha kalıcıdır",1,[["وَ",10,4794],["أَبْقَىٰٓ",323,1022]]]],"en":"While the Hereafter is better and more enduring.","tr":"Oysa ahiret daha iyi ve daha bakidir.","de":"während das Jenseits besser und beständiger ist."},{"a":18,"w":[["إِنَّ","Indeed","şüphesiz",0,[["إِنَّ",44,4]]],["هَـٰذَا","this","bu",1,[["هَٰ",132,4800],["ذَا",25,54]]],["لَفِى","surely (is) in","elbette vardı",1,[["لَ",106,4796],["فِى",19,2]]],["ٱلصُّحُفِ","the Scriptures","sahifelerde de",1,[["ٱل",3,4795],["صُّحُفِ",51,962]]],["ٱلْأُولَىٰ","[the] former","ilk",1,[["ٱلْ",3,4795],["أُولَىٰ",432,137]]]],"en":"Indeed, this is in the former scriptures,","tr":"Doğrusu bu hükümler ilk sahifelerde, İbrahim ve Musa'nın sahifelerinde de vardır.","de":"Dies ist wahrlich in den früheren Blättern (enthalten),"},{"a":19,"w":[["صُحُفِ","(The) Scriptures","sayfalarında",0,[["صُحُفِ",51,962]]],["إِبْرَٰهِيمَ","(of) Ibrahim","İbrahim'in",0,[["إِبْرَٰهِيمَ",163,174]]],["وَمُوسَىٰ","and Musa","ve Musa'nın",1,[["وَ",10,4794],["مُوسَىٰ",163,89]]]],"en":"The scriptures of Abraham and Moses.","tr":"Doğrusu bu hükümler ilk sahifelerde, İbrahim ve Musa'nın sahifelerinde de vardır.","de":"den Blättern Ibrahims und Musas."}]}